+/**
+ * 同一个读音的模糊音写法归一化后相等：en/eng、in/ing、uan/uang 是同一音节的不同写法，
+ * 选读音时它们该一起出字（用户 11-24：fen 选中后 feng 的字不能消失）。
+ * 而合并键布局里同码不同音节（shi / shuo、fen / gen）归一化后不等，选哪个就只剩哪个。
+ */
+internal fun fuzzySyllableKey(pinyin: String): String = when {
+    pinyin.length > 3 && pinyin.endsWith("eng") -> pinyin.dropLast(1)
+    pinyin.length > 3 && pinyin.endsWith("ing") -> pinyin.dropLast(1)
+    pinyin.length > 4 && pinyin.endsWith("uang") -> pinyin.dropLast(1)
+    else -> pinyin
+}
