+/**
+ * 模糊音等价类，全部从方案 speller/algebra 里的 `fuzz/正则/替换/` 规则推导，
+ * 不硬编码任何一组模糊音：
+ *
+ *   fuzz/eng$/en/   →  eng 与 en 等价
+ *   fuzz/en$/eng/   →  （反向，等价类闭合后就是 {en, eng}）
+ *   fuzz/^zh/z/     →  zh 与 z 等价（用户自己加 n/l、zh/z 之类也自动生效）
+ *
+ * 等价关系做完并查集后，任意两个拼音只要落在同一等价类就是「同一读音的不同写法」，
+ * 选读音时它们该一起出字；而合并键布局同码不同音节（shi/shuo、fen/gen）不会落到
+ * 同一类，选哪个就只剩哪个。
+ *
+ * [rules] 传 `speller/algebra` 的原始字符串列表；没有 fuzz 规则时等价类为空，
+ * 退化成硬锁（只保留选中的读音）。
+ */
+internal class FuzzySyllableEquivalences(rules: List<String>) {
+    /** 每条 fuzz 规则的「被替换片段」；等价类由这些片段是否互相派生决定。 */
+    private val literalReplacements: List<Pair<String, String>> = rules.mapNotNull { rule ->
+        val match = FUZZ_RULE.matchEntire(rule.trim()) ?: return@mapNotNull null
+        val pattern = match.groupValues[1]
+        val replacement = match.groupValues[2]
+        // 只处理「锚定在词尾/词首的纯字母」这类可逆的规则；正则太复杂时跳过，
+        // 宁可少合并也不要把不相干的音节并到一起。
+        val anchorEnd = pattern.endsWith("$") && pattern.startsWith("/").not()
+        val literal = pattern.trimStart('^').trimEnd('$')
+        if (literal.isEmpty() || literal.any { it !in 'a'..'z' }) return@mapNotNull null
+        if (!anchorEnd && !pattern.startsWith("^")) return@mapNotNull null
+        if (replacement.isEmpty() || replacement.any { it !in 'a'..'z' }) return@mapNotNull null
+        literal to replacement
+    }
+
+    /** 传给原生侧的规则原文，形如 "eng>en"；原生按段判等价，多段选择互不影响。 */
+    fun ruleLiterals(): Array<String> =
+        literalReplacements.map { (pattern, replacement) -> "$pattern>$replacement" }.toTypedArray()
+
+    /** 每个拼音的可达集合只算一次；音节总共四百多个，缓存后每次点击零成本。 */
+    private val reachableCache = HashMap<String, Set<String>>()
+
+    /** 两个拼音是否模糊音等价：把一个拼音按规则逐条替换，看能否得到另一个。 */
+    fun equivalent(a: String, b: String): Boolean {
+        if (a == b) return true
+        if (literalReplacements.isEmpty()) return false
+        return reachable(a).contains(b)
+    }
+
+    private fun reachable(from: String): Set<String> =
+        reachableCache.getOrPut(from) {
+            val seen = mutableSetOf(from)
+            val queue = ArrayDeque(listOf(from))
+            while (queue.isNotEmpty()) {
+                val current = queue.removeFirst()
+                for ((pattern, replacement) in literalReplacements) {
+                    for (next in applyRule(current, pattern, replacement)) {
+                        if (seen.add(next)) queue.addLast(next)
+                    }
+                }
+            }
+            seen.remove(from)
+            seen
+        }
+
+    /** 把一条 fuzz 规则作用到一个拼音上，返回所有可能的替换结果。 */
+    private fun applyRule(pinyin: String, pattern: String, replacement: String): List<String> {
+        val out = mutableListOf<String>()
+        // 形如 foo → bar：整段等于 foo 时替换
+        if (pinyin == pattern) out.add(replacement)
+        // 形如 foo 结尾：把结尾的 foo 换成 replacement
+        if (pinyin.length > pattern.length && pinyin.endsWith(pattern)) {
+            out.add(pinyin.dropLast(pattern.length) + replacement)
+        }
+        // 形如开头是 foo：把开头的 foo 换成 replacement
+        if (pinyin.length > pattern.length && pinyin.startsWith(pattern)) {
+            out.add(replacement + pinyin.drop(pattern.length))
+        }
+        // 反向规则（en$/eng/ 与 eng$/en/）会互相派生，必须限长，否则替换链不收敛。
+        return out.filter { it.length <= MAX_SYLLABLE_LENGTH }
+    }
+
+    private companion object {
+        /** `fuzz/被替换/替换/` */
+        val FUZZ_RULE = Regex("""^fuzz/(.*)/([^/]*)/$""")
+        /** 汉语拼音音节最长 6（zhuang / chuang），留一倍余量防止替换链发散。 */
+        const val MAX_SYLLABLE_LENGTH = 12
+    }
+}
