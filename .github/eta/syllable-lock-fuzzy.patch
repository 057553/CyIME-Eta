+inline bool FuzzyEquivalent(const std::string& a, const std::string& b) {
+  if (a.empty() || b.empty()) return false;
+  if (a == b) return true;
+  if (!g_fuzzy_rules || g_fuzzy_rules->empty()) return false;
+  std::set<std::string> seen{a};
