+inline constexpr size_t kMaxFuzzySyllableLength = 12;
+
+inline std::vector<std::string> ApplyFuzzyRule(const std::string& pinyin,
+                                               const std::string& pattern,
+                                               const std::string& replacement) {
+  std::vector<std::string> out;
+  if (pinyin == pattern) out.push_back(replacement);
+  if (pinyin.size() > pattern.size() &&
+      pinyin.compare(pinyin.size() - pattern.size(), pattern.size(), pattern) == 0) {
+    out.push_back(pinyin.substr(0, pinyin.size() - pattern.size()) + replacement);
+  }
+  if (pinyin.size() > pattern.size() && pinyin.compare(0, pattern.size(), pattern) == 0) {
+    out.push_back(replacement + pinyin.substr(pattern.size()));
+  }
+  out.erase(std::remove_if(out.begin(), out.end(),
+                           [](const std::string& v) { return v.size() > kMaxFuzzySyllableLength; }),
+            out.end());
+  return out;
